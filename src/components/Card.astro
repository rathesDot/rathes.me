---
import { Icon } from "astro-icon/components"

import { cx } from "@/src/cva.config"

type Props = {
  href?: string
  target?: string
  class?: string
}

const { href, target, class: className } = Astro.props
const Tag = href ? "a" : "div"
const isExternal = target === "_blank"
const classes = cx(
  "rounded-md border border-neutral-200 bg-neutral-50 px-4 py-3.5 text-neutral-900 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-100",
  className,
  isExternal && "whitespace-nowrap"
)
---

<Tag href={href} target={target} class={classes}>
  <slot />
  {
    isExternal && (
      <Icon
        name="heroicons:arrow-up-right-16-solid"
        aria-hidden="true"
        class="inline size-[0.95em] align-middle opacity-40"
      />
    )
  }
</Tag>
