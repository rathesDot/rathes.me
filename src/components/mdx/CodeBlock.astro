---
import { cva } from "@/src/cva.config"

const styles = cva({
  base: "my-8 overflow-x-auto rounded-sm bg-neutral-50 p-8 text-neutral-500 outline outline-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:outline-neutral-800",
})

const { class: className, ...props } = Astro.props
---

<pre class={styles({ className })} {...props}><slot /></pre>
