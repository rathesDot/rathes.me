---
import { cva, type VariantProps } from "@/src/cva.config"

const styles = cva({
  base: "my-8 p-8 bg-neutral-50 text-neutral-500 outline outline-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:outline-neutral-800 rounded-sm",
  variants: {
    fontFamily: {
      mono: "font-mono",
    },
  },
})

type Props = VariantProps<typeof styles> & { class?: string }

const { class: className, fontFamily, ...props } = Astro.props
---

<div class={styles({ fontFamily, className })} {...props}><slot /></div>
