---
import { Icon } from "astro-icon/components"

import { cva, cx, type VariantProps } from "@/src/cva.config"

import { getBlogImage } from "@/services/blogImages"

export const link = cva({
  base: "text-current antialiased transition-colors dark:text-neutral-300 dark:hover:text-white",
  variants: {
    underlined: {
      true: "underline underline-offset-2 decoration-neutral-300 hover:decoration-neutral-900 dark:decoration-neutral-600 dark:hover:decoration-neutral-400",
      false: "no-underline",
    },
  },
  defaultVariants: {
    underlined: true,
  },
})

type Props = VariantProps<typeof link> & {
  href: string
  class?: string
  target?: string
  rel?: string
  title?: string
  download?: boolean | string
  "aria-label"?: string
}

const { underlined, class: className, href, target, ...props } = Astro.props

// Posts sometimes link to a blog image directly by its old public path.
const resolvedHref = getBlogImage(href)?.src ?? href
const isExternal = target === "_blank"
const isUnderlined = underlined ?? true
---

<a
  class={link({
    underlined,
    className: cx(className, isExternal && "whitespace-nowrap"),
  })}
  href={resolvedHref}
  target={target}
  {...props}
>
  <slot />
  {
    isExternal && (
      <Icon
        name="heroicons:arrow-up-right-16-solid"
        aria-hidden="true"
        class={cx(
          "inline size-[0.95em] align-middle opacity-40",
          isUnderlined && "underline"
        )}
      />
    )
  }
</a>
