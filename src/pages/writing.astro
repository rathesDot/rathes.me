---
import { Icon } from "astro-icon/components"

import Layout from "@/layouts/Layout.astro"
import Search from "@/patterns/Search.astro"

import Heading, { heading } from "@/components/Heading.astro"
import Link from "@/components/Link.astro"
import Paragraph from "@/components/Paragraph.astro"
import ListRoot from "@/components/list/Root.astro"
import ListContainer from "@/components/list/Container.astro"
import ListEntry from "@/components/list/Item.astro"
import ListLink from "@/components/list/Link.astro"

import { getAllBlogPosts } from "@/services/blog"

const DESCRIPTION =
  "I write about all sort of topics, not just tech! It could be related to start ups, design or just some of my personal thoughts"

const groups = await getAllBlogPosts()

const summaryStyles = heading({
  level: "small",
  className:
    "flex cursor-pointer list-none items-center gap-1 [&::-webkit-details-marker]:hidden",
})
---

<Layout title="Writing" description={DESCRIPTION} path="/writing">
  <main class="space-y-8 py-4 lg:py-8">
    <section class="mx-auto max-w-lg px-4 sm:px-0">
      <Heading as="h1">Writing</Heading>
      <Paragraph>
        From time to time, I do write. Sometime on my blog, but also on other
        blogs such as on <Link href="https://medium.com/@rathes">Medium</Link>.
        The topics, I write about are diverse. Obviously, I write about the web,
        but also about non-web topics like my mother tongue Tamil or even about
        movies or anime.
      </Paragraph>
      <Paragraph>
        I do write in English, German and Tamil. So if you do not understand the
        title, it may be that you do not speak the language. If you want me to
        translate a specific article, just drop a message{" "}
        <Link target="_blank" href="https://bsky.app/profile/rathes.me">
          on Bluesky
        </Link>
      </Paragraph>
    </section>

    <section class="space-y-8 py-4">
      <div class="mx-auto max-w-lg px-4 sm:px-0">
        <Search placeholder="Blog post title" />
      </div>
      <div class="mx-auto max-w-lg px-4 sm:px-0">
        <ListRoot>
          <details class="group block" data-more>
            <summary class={summaryStyles}>
              <Icon
                name="heroicons:chevron-right-16-solid"
                class="size-4 group-open:hidden"
              />
              <Icon
                name="heroicons:chevron-down-16-solid"
                class="hidden size-4 group-open:block"
              />
              Books, recipes and more
            </summary>
            <ListContainer class="mt-3 space-y-2 pl-5">
              <ListEntry>
                <ListLink href="https://learn-tamil.com/books/guide-to-basic-tamil-grammar">
                  A Guide To Basic Tamil Grammar
                </ListLink>
              </ListEntry>
              <ListEntry>
                <ListLink href="/biryani">Chicken biryani recipe</ListLink>
              </ListEntry>
            </ListContainer>
          </details>
        </ListRoot>
      </div>

      {
        groups.map(([year, posts]) =>
          posts.length ? (
            <div class="mx-auto max-w-lg px-4 sm:px-0" data-post-group>
              <ListRoot>
                <details class="group block" open>
                  <summary class={summaryStyles}>
                    <Icon
                      name="heroicons:chevron-right-16-solid"
                      class="size-4 group-open:hidden"
                    />
                    <Icon
                      name="heroicons:chevron-down-16-solid"
                      class="hidden size-4 group-open:block"
                    />
                    {year}
                  </summary>
                  <ListContainer class="mt-3 space-y-2 pl-5">
                    {posts.map((post) => (
                      <ListEntry
                        data-post={`${post.title} ${post.link}`.toLowerCase()}
                      >
                        <ListLink
                          href={post.link}
                          lang={post.lang}
                          class="flex items-center gap-1"
                        >
                          {post.title}
                          {post.external && (
                            <Icon
                              name="heroicons:arrow-up-right-16-solid"
                              class="inline size-5 text-neutral-400"
                            />
                          )}
                        </ListLink>
                      </ListEntry>
                    ))}
                  </ListContainer>
                </details>
              </ListRoot>
            </div>
          ) : null
        )
      }
    </section>
  </main>
</Layout>

<script src="../scripts/writing-search.ts"></script>
