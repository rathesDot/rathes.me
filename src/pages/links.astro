---
import LinksLayout from "@/layouts/LinksLayout.astro"
import Heading from "@/components/Heading.astro"
import CardLink from "@/patterns/CardLink.astro"

import Bluesky from "@/components/icons/Bluesky.astro"
import GitHub from "@/components/icons/GitHub.astro"
import Instagram from "@/components/icons/Instagram.astro"
import LinkedIn from "@/components/icons/LinkedIn.astro"
import Threads from "@/components/icons/Threads.astro"
import YouTube from "@/components/icons/YouTube.astro"
---

<LinksLayout
  title="Links"
  description="Where to find Rathes Sachchithananthan online — Bluesky, Instagram, GitHub, LinkedIn, Threads and YouTube — plus the projects he is building."
  path="/links"
>
  <main class="mx-auto max-w-lg space-y-16 px-4 sm:px-0">
    <section>
      <ul class="space-y-2">
        <li>
          <CardLink href="https://bsky.app/profile/rathes.me" external>
            <Bluesky class="size-4" />
            Bluesky
          </CardLink>
        </li>
        <li>
          <CardLink href="https://instagram.com/tamizhographer" external>
            <Instagram class="size-4" />
            Instagram
          </CardLink>
        </li>
        <li>
          <CardLink href="https://github.com/rathesDot" external>
            <GitHub class="size-4" />
            GitHub
          </CardLink>
        </li>
        <li>
          <CardLink
            href="https://www.linkedin.com/in/rathes-sachchithananthan/"
            external
          >
            <LinkedIn class="size-4" />
            LinkedIn
          </CardLink>
        </li>
        <li>
          <CardLink href="https://threads.com/@tamizhographer" external>
            <Threads class="size-4" />
            Threads
          </CardLink>
        </li>
        <li>
          <CardLink href="https://youtube.com/@tamizhographer" external>
            <YouTube class="size-4" />
            YouTube
          </CardLink>
        </li>
      </ul>
    </section>
    <section>
      <header class="mb-3 flex items-center justify-between">
        <Heading as="h2" level="small">Projects</Heading>
      </header>
      <ul class="space-y-2">
        <li>
          <CardLink href="/">Personal website</CardLink>
        </li>
        <li>
          <CardLink href="https://aheenam.com/apps/offset" external>
            Offset
          </CardLink>
        </li>
        <li>
          <CardLink href="https://aheenam.com/templates/calais" external>
            Calais Portfolio Template
          </CardLink>
        </li>
        <li>
          <CardLink href="https://learn-tamil.com/" external>
            Learn Tamil Online
          </CardLink>
        </li>
        <li>
          <CardLink href="https://getmaxout.app" external>
            Maxout 2.0
          </CardLink>
        </li>
        <li>
          <CardLink href="/blog/closing-mozhi">Mozhi</CardLink>
        </li>
      </ul>
    </section>
  </main>
</LinksLayout>
