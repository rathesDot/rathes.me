---
import Layout from "@/layouts/Layout.astro"
import Link from "@/components/Link.astro"
import Heading from "@/components/Heading.astro"
import Paragraph from "@/components/Paragraph.astro"
import ProjectCard from "@/patterns/ProjectCard.astro"

import OffsetPreview from "@/assets/images/offset-preview.png"
import CalaisPreview from "@/assets/images/calais-preview.png"
import LearnTamilPreview from "@/assets/images/learn-tamil-preview.png"

const projects = [
  {
    title: "Aisle Zero",
    description:
      "The pre-shop grocery list that learns your store, so you never backtrack down another aisle.",
    href: "https://aheenam.com/apps/aisle-zero",
  },
  {
    title: "Maxout",
    description:
      "A companion that helps you organize and maintain a healthy lifestyle — the knowledge and tooling in one place.",
    href: "https://getmaxout.app",
  },
  {
    title: "Learn Tamil Online",
    description:
      "One of the oldest living languages, close to my heart — a platform to learn and practice Tamil.",
    href: "https://learn-tamil.com/",
    image: LearnTamilPreview,
    imageAlt:
      "Image showcasing a book cover on the left and two screens of the Learn Tamil App in the center and right",
  },
  {
    title: "Offset",
    description:
      "My first fully native macOS app — a menubar to check colleagues' local times across time zones.",
    href: "https://aheenam.com/apps/offset",
    image: OffsetPreview,
    imageAlt: "Preview of the macOS menubar app 'Offset'",
  },
  {
    title: "Workout Timer",
    description:
      "A simple, focused interval timer for iOS to manage your workout sessions with fully customizable settings.",
    href: "https://aheenam.com/apps/workout-timer",
  },
  {
    title: "The Kegel Club",
    description:
      "A simple, private pelvic floor trainer that keeps every exercise, reminder and streak entirely on your device.",
    href: "https://aheenam.com/apps/the-kegel-club",
  },
  {
    title: "Calais",
    description:
      "A personal portfolio theme I built as an exploration for my own site — a minimal approach with a single accent color.",
    href: "https://aheenam.com/templates/calais",
    image: CalaisPreview,
    imageAlt: "Preview of template named 'Calais'",
  },
]
---

<Layout
  title="Work"
  description="When I am not working at my day job, you will find me exploring new technology or design and working on some side projects. This is a list of the things I am working on at the moment."
  path="/work"
>
  <main class="space-y-12 py-4 lg:py-8">
    <section>
      <Heading as="h1">My work</Heading>
      <Paragraph>
        By day, I'm a Senior Software Engineer at Buffer. After hours, I'm
        building out{" "}
        <Link href="https://aheenam.com" target="_blank">Aheenam</Link>, a
        studio for the ideas I can't leave alone — the projects below are what I
        am currently working on or what landed.
      </Paragraph>
    </section>

    <section>
      <ul class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2">
        {
          projects.map((project) => (
            <li>
              <ProjectCard {...project} />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
