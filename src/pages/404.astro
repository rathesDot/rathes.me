---
// Cloudflare Pages serves dist/404.html with a 404 status for unknown URLs.
// Without it, Pages would treat the site as an SPA and answer every unknown
// URL with the home page and a 200.
import BaseLayout from "@/layouts/BaseLayout.astro"
import Heading from "@/components/Heading.astro"
---

<BaseLayout title="Page not found" description={null} path="/404">
  <main class="mx-auto max-w-lg space-y-6 px-4 sm:px-0">
    <Heading as="h1">Page not found</Heading>
    <p>There is nothing at this address. <a href="/" class="underline">Go to the home page</a>.</p>
  </main>
</BaseLayout>
