---
import { Icon } from "astro-icon/components"

import BaseLayout, {
  type Props as BaseLayoutProps,
} from "@/layouts/BaseLayout.astro"
import Link from "@/components/Link.astro"
import Logo from "@/components/Logo.astro"
import SayHi from "@/patterns/SayHi.astro"

type Props = BaseLayoutProps

const props = Astro.props

const navItems = [
  { href: "/about", label: "About" },
  { href: "/work", label: "Work" },
  { href: "/writing", label: "Writing" },
  { href: "/reading", label: "Reading" },
  { href: "/photography", label: "Photos" },
  { href: "https://aheenam.com", label: "Studio", external: true },
]
---

<BaseLayout {...props}>
  <nav
    id="site-nav"
    class="group peer ease sticky top-2 z-50 mx-2 max-w-2xl overflow-hidden rounded-2xl border border-neutral-900/5 bg-white/70 backdrop-blur-sm transition-colors data-open:border-transparent data-open:bg-neutral-50 sm:mx-auto md:top-4 dark:border-neutral-800/50 dark:bg-neutral-950/70 dark:data-open:bg-neutral-50/5"
  >
    <div class="px-1.5">
      <div class="flex flex-wrap items-center justify-between md:flex-nowrap">
        <a
          href="/"
          title="Home"
          class="block px-1 py-4 text-sm text-neutral-900 antialiased dark:text-neutral-400"
        >
          <Logo class="size-5 text-neutral-900 dark:text-neutral-400" />
        </a>
        <button
          type="button"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          aria-label="Toggle navigation"
          class="relative -m-1 flex size-9 shrink-0 items-center justify-center rounded-full text-neutral-900 transition-colors hover:bg-black/5 md:hidden dark:text-neutral-400 dark:hover:bg-white/10"
        >
          <Icon
            name="heroicons:bars-3"
            class="absolute inset-0 m-auto size-5 transition-all duration-200 group-data-open:rotate-90 group-data-open:opacity-0"
          />
          <Icon
            name="heroicons:x-mark"
            class="absolute inset-0 m-auto size-5 -rotate-90 opacity-0 transition-all duration-200 group-data-open:rotate-0 group-data-open:opacity-100"
          />
        </button>
        <div
          class="grid w-full grid-rows-[0fr] overflow-hidden transition-[grid-template-rows] duration-300 ease-in-out group-data-open:grid-rows-[1fr] md:w-auto md:grid-rows-[1fr] md:overflow-visible md:transition-none"
        >
          <ul
            id="nav-links"
            class="flex min-h-0 flex-col md:flex-row md:items-center md:gap-6 md:pb-0"
          >
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    class="inline-flex items-center gap-1.5 px-1 py-2 text-xs font-medium text-neutral-600 antialiased transition-colors hover:text-neutral-950 md:py-4 dark:text-neutral-400 dark:hover:text-neutral-100"
                  >
                    {item.label}
                    {item.external && (
                      <Icon
                        name="heroicons:arrow-up-right-16-solid"
                        class="size-3"
                      />
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </nav>

  <div class="mx-auto mt-8 max-w-2xl px-4">
    <slot />
  </div>

  <div class="mx-auto mt-8 max-w-2xl px-4">
    <footer class="max-w-lg space-y-12 px-4 py-8 sm:px-0">
      <SayHi />
      <div class="text-xs text-neutral-600 dark:text-neutral-400">
        &copy; {new Date().getFullYear()} / <Link href="/links"
          >@tamizhographer</Link
        >
      </div>
    </footer>
  </div>

  <script src="../scripts/nav-menu.ts"></script>
</BaseLayout>
