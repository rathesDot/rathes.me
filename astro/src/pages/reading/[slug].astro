---
import Layout from "@/layouts/Layout.astro"

import Heading from "@/components/Heading.astro"
import Link from "@/components/Link.astro"
import Paragraph from "@/components/Paragraph.astro"
import Rating from "@/components/Rating.astro"
import BookSchema from "@/components/BookSchema.astro"

import { createSlug, getBookUrl, getRatedBooks } from "@/services/books"

export function getStaticPaths() {
  return getRatedBooks().map((book) => ({
    params: { slug: createSlug(book) },
    props: { book },
  }))
}

const { book } = Astro.props
const { title, author, url, description, genres, rating } = book
---

<Layout title={title} description={description} path={getBookUrl(book)}>
  <main class="mx-auto max-w-lg space-y-4 px-4 py-4 sm:px-0">
    <BookSchema book={book} />
    <header>
      <Heading as="h1" class="mb-0">{title}</Heading>
      <p
        class="block text-sm leading-relaxed text-neutral-500 antialiased dark:text-neutral-400"
      >
        by {author}
      </p>
    </header>
    <div class="space-y-2">
      <Heading as="h2" level="small">Rating</Heading>
      <Rating value={rating || 0} />
    </div>
    <div class="space-y-1">
      <Heading as="h2" level="small">Genres</Heading>
      <div class="inline-flex flex-wrap gap-2">
        {
          (genres || []).map((genre) => (
            <Link
              underlined
              class="text-sm"
              href={`/reading?genre=${genre.toLowerCase()}`}
            >
              {genre}
            </Link>
          ))
        }
      </div>
    </div>
    <div>
      <Link
        target="_blank"
        class="inline-block rounded-md bg-neutral-200 px-3 py-2.5 font-semibold text-neutral-700 antialiased dark:bg-neutral-800 dark:text-neutral-300"
        underlined={false}
        href={url}
      >
        Buy on Amazon
      </Link>
    </div>
    {description && <Paragraph>{description}</Paragraph>}
  </main>
</Layout>
