---
import MagnifyingGlassIcon from "@/components/MagnifyingGlassIcon.astro"
import { heading } from "@/components/Heading.astro"

type Props = {
  id?: string
  placeholder?: string
}

const { id = "search", placeholder } = Astro.props
---

<label class={heading({ level: "small", className: "mb-1 block" })} for={id}>
  Search
</label>
<div
  class="flex items-center gap-2 rounded-lg bg-neutral-100 px-2 py-1.5 ring ring-transparent transition-colors focus-within:ring-neutral-200 dark:bg-neutral-800 dark:ring-neutral-800 dark:focus-within:ring-neutral-700"
>
  <span>
    <MagnifyingGlassIcon class="size-5 text-neutral-400" />
  </span>
  <input
    id={id}
    type="search"
    autocomplete="off"
    aria-label="Search"
    placeholder={placeholder}
    class="box-border inline-flex w-full max-w-md items-center justify-center text-base text-neutral-800 outline-hidden placeholder:font-medium placeholder:text-neutral-400 dark:text-neutral-50"
  />
</div>
