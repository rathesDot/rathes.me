---
import Link from "@/components/Link.astro"
import Logo from "@/components/Logo.astro"
import SayHi from "@/patterns/SayHi.astro"

import { SITE_URL } from "@/src/site.config"

import "@/styles/globals.css"

type Props = {
  title: string
  description: string
  path: string
}

const { title, description, path } = Astro.props
const canonicalUrl = `${SITE_URL}${path}`

const navItems = [
  { href: "/about", label: "About" },
  { href: "/work", label: "Work" },
  { href: "/writing", label: "Writing" },
  { href: "/reading", label: "Reading" },
  { href: "/photography", label: "Photos" },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --font-inter: "Inter", sans-serif;
      }
    </style>

    <title>{title} — Rathes Sachchithananthan</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href={SITE_URL} />
    <meta name="author" content="Rathes Sachchithananthan" />
    <meta name="referrer" content="origin-when-cross-origin" />
    <meta name="creator" content="Rathes Sachchithananthan" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body
    class="bg-white font-sans text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-50"
  >
    <nav
      class="sticky top-0 mt-0 border-b bg-white/70 backdrop-blur-sm dark:border-b-neutral-800 dark:bg-neutral-950/70"
    >
      <div class="mx-auto max-w-lg px-4 sm:px-0">
        <ul class="flex items-center justify-between">
          <li>
            <a
              href="/"
              title="Home"
              class="block px-1 py-4 text-sm text-neutral-900 antialiased dark:text-neutral-400"
            >
              <Logo class="size-5 text-neutral-900 dark:text-neutral-400" />
            </a>
          </li>
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block px-1 py-4 text-sm text-neutral-900 antialiased dark:text-neutral-400"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <slot />

    <footer class="mx-auto max-w-lg space-y-12 px-4 py-8 sm:px-0">
      <SayHi />
      <div class="text-xs text-neutral-600 dark:text-neutral-400">
        &copy; {new Date().getFullYear()} / <Link href="/links"
          >@tamizhographer</Link
        >
      </div>
    </footer>
  </body>
</html>
