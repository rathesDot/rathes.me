---
import { Font } from "astro:assets"

import { DEFAULT_SOCIAL_IMAGE, FEED_PATH, SITE_URL } from "@/src/site.config"

import "@/styles/globals.css"

// Pages that don't set their own description inherit this one.
const DEFAULT_DESCRIPTION =
  "I'm a passionate software engineer and maker turning ideas into reality.  I specialize in web development with React and Laravel and can help you with custom solutions for your projects.  Let's discuss your project and see how I can help make it a success!"

export type Props = {
  title: string
  // Replaces the "{title} — Rathes Sachchithananthan" document title, which
  // blog posts render as "{title} — rathes.me" instead.
  documentTitle?: string
  // null drops the description tags entirely, which is what a post without a
  // description of its own does rather than inheriting the site blurb.
  description?: string | null
  path: string
  type?: "website" | "article"
  locale?: string
  image?: { url: string; width?: number; height?: number }
  publishedTime?: string
  modifiedTime?: string
  author?: string
  // hreflang entries, emitted only for posts that exist in both languages.
  translations?: { language: string; path: string }[]
}

const {
  title,
  documentTitle,
  description: ownDescription,
  path,
  type = "website",
  locale,
  image = DEFAULT_SOCIAL_IMAGE,
  publishedTime,
  modifiedTime,
  author,
  translations = [],
} = Astro.props

const description =
  ownDescription === null ? undefined : (ownDescription ?? DEFAULT_DESCRIPTION)

const canonicalUrl = `${SITE_URL}${path}`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Inter is self-hosted, so its @font-face rules come inline instead of
        behind a stylesheet from fonts.googleapis.com, and the one file the
        family needs is preloaded. */}
    <Font cssVariable="--font-inter" preload />

    <title>{documentTitle ?? `${title} — Rathes Sachchithananthan`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      translations.map((translation) => (
        <link
          rel="alternate"
          hreflang={translation.language}
          href={`${SITE_URL}${translation.path}`}
        />
      ))
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      href={`${SITE_URL}${FEED_PATH}`}
    />
    <link rel="icon" href="/icon.png" sizes="513x513" type="image/png" />
    <link
      rel="apple-touch-icon"
      href="/icon.png"
      sizes="513x513"
      type="image/png"
    />
    <link rel="author" href={SITE_URL} />
    <meta name="author" content="Rathes Sachchithananthan" />
    <meta name="referrer" content="origin-when-cross-origin" />
    <meta name="creator" content="Rathes Sachchithananthan" />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    {locale && <meta property="og:locale" content={locale} />}
    <meta property="og:image" content={image.url} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
    {author && <meta property="article:author" content={author} />}
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {/* Fathom counts pageviews on its own; every navigation is a page load. */}
    <script
      is:inline
      defer
      src="https://cdn.usefathom.com/script.js"
      data-site="ZYWCGBNZ"
      data-included-domains="rathes.me"></script>

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {/* The same image og:image carries, so a post shares its own cover. */}
    <meta name="twitter:image" content={image.url} />
  </head>
  <body
    class="bg-white font-sans text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-50"
  >
    <slot />
  </body>
</html>
