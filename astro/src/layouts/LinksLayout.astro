---
import { Image } from "astro:assets"

import BaseLayout from "@/layouts/BaseLayout.astro"
import Heading from "@/components/Heading.astro"
import Link from "@/components/Link.astro"
import Paragraph from "@/components/Paragraph.astro"

import Profile from "@/assets/images/profile-picture.png"

type Props = {
  title: string
  description?: string
  path: string
}

const { title, description, path } = Astro.props
---

<BaseLayout title={title} description={description} path={path}>
  <header class="mx-auto max-w-lg space-y-8 pt-16 pb-10 text-center">
    <Image
      src={Profile}
      alt="Profile picture of Rathes Sachchithananthan"
      class="mx-auto size-24 rounded-full"
    />
    <div>
      <Heading as="h1" level="h2">Rathes Sachchithananthan</Heading>
      <Paragraph class="mx-auto my-1 max-w-sm text-balance">
        Web engineer interested in languages, fitness, reading and cooking.
      </Paragraph>
    </div>
  </header>

  <slot />

  <footer class="mx-auto max-w-lg space-y-12 px-4 py-8 text-center sm:px-0">
    <div class="text-xs text-neutral-600 dark:text-neutral-400">
      &copy; {new Date().getFullYear()} / <Link href="https://rathes.me"
        >@tamizhographer</Link
      >
    </div>
  </footer>
</BaseLayout>
