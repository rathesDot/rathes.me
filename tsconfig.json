{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/src/*": ["./src/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/components/*": ["./src/components/*"],
      "@/patterns/*": ["./src/patterns/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/services/*": ["./src/services/*"],
      "@/data/*": ["./src/data/*"]
    }
  }
}
